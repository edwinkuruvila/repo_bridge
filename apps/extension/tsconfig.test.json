    "lib/directive-lifecycle.ts",
    "lib/directive-stability.ts",
    "lib/conversation-session.ts",
    "lib/chatgpt-context.ts",
    "lib/chatgpt-exec.ts",
    "lib/chatgpt-git.ts",
    "lib/chatgpt-read.ts",
    "lib/chatgpt-run.ts",
    "lib/chatgpt-patch.ts",
    "lib/chatgpt-code-block.ts",
    "lib/chatgpt-directive-error.ts",
    "lib/composer-delivery.ts",
    "lib/exec-policy.ts",
    "lib/result-outbox.ts",
    "lib/user-gesture.ts"
  ]
